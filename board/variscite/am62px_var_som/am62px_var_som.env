#include <env/ti/ti_common.env>
#include <env/ti/mmc.env>
#include <env/ti/k3_dfu.env>
#if CONFIG_CMD_REMOTEPROC
#include <env/ti/k3_rproc.env>
#endif

main_cpsw0_qsgmii_phyinit=false

name_kern=Image
console=ttyS0,115200n8
args_all=setenv optargs ${optargs} earlycon=ns16550a,mmio32,0x02800000

run_kern=booti ${loadaddr} ${rd_spec} ${fdtaddr}

setbootpart_mmc=setenv bootpart ${mmcdev}:${mmcpart}
args_mmc=run setbootpart_mmc;
	setenv bootargs console=${console}
	${optargs}
	root=/dev/mmcblk${mmcblk}p${mmcpart} rw
	rootfstype=${mmcrootfstype}

boot_targets=mmc1 mmc0 usb pxe dhcp
boot=mmc
mmcpart=2
mmcdev=1
bootpart=1:2
bootdir=/boot
rd_spec=-

fdtfile=k3-am62p5-var-som-symphony.dtb
name_fdt=k3-am62p5-var-som-symphony.dtb
/* Also set the findfdt legacy script to warn users to stop using this */
findfdt="echo WARN: fdtfile already set. Stop using findfdt in script"

splashsourceauto=yes
splashfile=/boot/splash.bmp
splashimage=0x80200000
splashenable=setenv splashfile ${bootdir}/splash.bmp; \
	setenv splashimage 0x80200000
splashdisable=setenv splashfile; setenv splashimage
rproc_fw_binaries= 0 /lib/firmware/am62p-mcu-r5f0_0-fw

#if CONFIG_BOOTMETH_ANDROID
#include <env/ti/android.env>
force_avb=0
adtb_idx=3
#endif
